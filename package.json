{
  "name": "temple-seva-billing-system",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm -w apps/api run dev",
    "dev:web": "npm -w apps/web run dev",
    "build": "npm run db:generate && npm run build:shared && npm run build:web && npm run build:api",
    "build:shared": "npm -w packages/shared run build",
    "build:api": "npm -w apps/api run build",
    "build:web": "npm -w apps/web run build",
    "start": "npm run db:push && npm run db:seed && node apps/api/dist/index.js",
    "db:prep": "node scripts/prep-db.js",
    "db:generate": "node scripts/prep-db.js && npx --yes prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:push": "node scripts/prep-db.js && npx --yes prisma db push --schema=apps/api/prisma/schema.prisma",
    "db:seed": "node apps/api/dist/seed.js",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "npm -w apps/api run lint",
    "lint:web": "npm -w apps/web run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
